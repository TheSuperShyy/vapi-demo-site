# Copy to .env (gitignored). Set the same names in Vercel > Project > Settings > Environment Variables.

# Vapi private key (dashboard.vapi.ai > Settings > API Keys). Read by api/ only.
VAPI_PRIVATE_KEY=

# Supabase > Connect > Transaction pooler (port 6543). Read by api/ only.
# postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Shared secret Vapi must present on POST /api/webhook (header X-Vapi-Secret or ?token=).
# Any long random string. Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VAPI_WEBHOOK_SECRET=

# Dashboard login. When set, the site shows a sign-in screen and the API refuses requests
# without it. Leave empty for no login. The /demo page never needs it.
DASHBOARD_PASSWORD=

# Optional, production only. The Vapi phone number to dial out from (dashboard.vapi.ai
# > Phone Numbers > the number's id). When set, the List's Call button dials for real;
# when unset, the call runs in the browser.
VAPI_PHONE_NUMBER_ID=

# OpenRouter, for the AI write-up on the Analysis page. Without it the page shows
# only the counted findings. Model is optional; the default is Gemini flash.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
