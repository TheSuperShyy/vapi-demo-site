# Copy to .env (gitignored). Set the same names in Vercel > Project > Settings > Environment Variables.

# Vapi private key (dashboard.vapi.ai > Settings > API Keys). Read by api/ only.
VAPI_PRIVATE_KEY=

# Supabase > Connect > Transaction pooler (port 6543). Read by api/ only.
# postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Shared secret Vapi must present on POST /api/webhook (header X-Vapi-Secret or ?token=).
# Any long random string. Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VAPI_WEBHOOK_SECRET=

# Optional. When set, the dashboard asks for it once and the API refuses requests without it.
DASHBOARD_PASSWORD=
